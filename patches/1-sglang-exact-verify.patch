+) -> torch.Tensor:
+    """Linear-chain target verify on the packed decode kernel.
+
+    mixed_qkv / a / b hold B * T packed rows, request-major (T = num_draft_tokens).
+    Each request's T rows step the decode recurrence in order from
+    ``initial_state[ssm_state_indices[n]]``; the state after step t goes to
+    ``intermediate_states_buffer[intermediate_state_indices[n], t]`` and the
+    initial state is left untouched, as for the recurrent verify kernel.
+    Returns the output as [B * T, HV, V].
+    """
+    T = int(num_draft_tokens)
+    if mixed_qkv.ndim != 2 or mixed_qkv.stride(-1) != 1:
+        raise ValueError("`mixed_qkv` must be 2D and contiguous in the last dim.")
+    if a.stride(-1) != 1 or b.stride(-1) != 1:
+        raise ValueError("`a`/`b` must be contiguous in the last dim.")
+    rows = mixed_qkv.shape[0]
+    if T <= 0 or rows % T != 0:
+        raise ValueError(f"{rows} packed rows are not a multiple of T={T}.")
+    B = rows // T
+    HV, V, K = initial_state.shape[-3:]
+    if tuple(intermediate_states_buffer.shape[-3:]) != (HV, V, K):
+        raise ValueError("Intermediate state buffer does not match the state layout.")
+    qk_dim = mixed_qkv.shape[1] - HV * V
+    H = qk_dim // 2 // K
+    BK = triton.next_power_of_2(K)
+    if triton.cdiv(K, BK) != 1:
+        raise ValueError(f"Packed verify kernel only supports NK=1 (got K={K}).")
+    BV = min(triton.next_power_of_2(V), 32)
